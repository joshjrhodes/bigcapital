# ── RPW Platform — environment template ─────────────────────────────────────
# Copy to `.env` and fill in the blanks. `.env` is git-ignored; this file is not.
# Generate each secret with:  openssl rand -base64 36 | tr -d '\n/+=' | head -c 48
#
# This file must stay in sync with `.env` whenever a new variable is introduced.
# ── Compose wiring ──────────────────────────────────────────────────────────
# Base upstream prod stack + RPW overlay (build from this fork) + laptop-only bits.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.rpw.yml:docker-compose.override.yml
COMPOSE_PROJECT_NAME=rpw

# ── Application ─────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8080
PUBLIC_PROXY_PORT=8080
PUBLIC_PROXY_SSL_PORT=8443

# ── Auth secrets ────────────────────────────────────────────────────────────
JWT_SECRET=
APP_JWT_SECRET=

# ── Database (MariaDB) ──────────────────────────────────────────────────────
DB_HOST=mysql
DB_USER=bigcapital
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8

# System database (accounts, tenants registry)
SYSTEM_DB_NAME=bigcapital_system

# Per-tenant databases are created as <prefix><tenant_id>
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# ── Redis / queues ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_HOST=redis
QUEUE_PORT=6379

# ── Sign-up restrictions (single-user system) ───────────────────────────────
# Single-user system. Leave false only long enough to create the first account
# (rpw/scripts/provision_books.py does that), then set it to true.
SIGNUP_DISABLED=true
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# ── Mail (Zoho SMTP — wired up in Phase 1) ──────────────────────────────────
# Zoho Mail SMTP. The mailbox lives on rhodespw.com — rhodesproductionworks.com
# has no MX records, so it is not a mailbox. MAIL_PASSWORD must be a Zoho
# *app-specific* password, and SMTP requires Mail Lite or above (the Forever
# Free plan blocks SMTP entirely, which fails as a 535 no matter the password).
# Verify with: python3 rpw/scripts/test_email.py --send
MAIL_HOST=smtp.zoho.com
MAIL_USERNAME=josh@rhodespw.com
MAIL_PASSWORD=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_FROM_NAME=Rhodes Production Works
MAIL_FROM_ADDRESS=josh@rhodespw.com

# ── PDF rendering (Gotenberg) ───────────────────────────────────────────────
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_DOCS_URL=http://server:3000/public/

# ── Exchange rates (optional) ───────────────────────────────────────────────
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=

# ── Bank feeds / Plaid (unused) ─────────────────────────────────────────────
BANK_FEED_ENABLED=false
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=

# ── Cloud-only billing (unused, self-hosted) ────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
HOSTED_ON_BIGCAPITAL_CLOUD=false

# ── Telemetry (off) ─────────────────────────────────────────────────────────
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=false
NEW_RELIC_LOG=stdout
NEW_RELIC_AI_MONITORING_ENABLED=false
NEW_RELIC_CUSTOM_INSIGHTS_EVENTS_MAX_SAMPLES_STORED=
NEW_RELIC_SPAN_EVENTS_MAX_SAMPLES_STORED=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
POSTHOG_API_KEY=
POSTHOG_HOST=

# ── Object storage for attachments (MinIO, in this compose stack) ──────────
# Upstream only knows how to store attachments in S3-compatible storage, so we
# run our own. These credentials are the MinIO root user — they never leave the
# compose network. S3_FORCE_PATH_STYLE is required for MinIO.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rpw-attachments
S3_FORCE_PATH_STYLE=true

# ── Stripe (Phase 6) ────────────────────────────────────────────────────────
STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=

# ── API throttling ──────────────────────────────────────────────────────────
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=30
